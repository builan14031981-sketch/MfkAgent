                    },
                    "state": {
                        "type": "string",
                        "enum": ["open", "closed", "all"],
                        "description": "Issue 状态过滤，默认 open",
                    },
                    "labels": {
                        "type": "string",
                        "description": "按 label 过滤（可选，多个用逗号分隔）",
                    },
