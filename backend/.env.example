# MfkAgent 环境配置

# 应用配置
APP_NAME=MfkAgent
DEBUG=True

# 数据库配置
# 留空则使用 config.py 基于 __file__ 自动计算的绝对路径（backend/mfkagent.db），
# 与启动目录无关，不会在根目录遗留 db 文件。
# DATABASE_URL=

# 小米MiMo配置
MIMO_API_KEY=your-mimo-api-key
MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1

# DeepSeek配置
DEEPSEEK_API_KEY=your-deepseek-api-key

# 硅基流动配置
SILICONFLOW_API_KEY=your-siliconflow-api-key

# 通义千问配置
QWEN_API_KEY=your-qwen-api-key

# 智谱AI配置
GLM_API_KEY=your-glm-api-key

# Moonshot配置
MOONSHOT_API_KEY=your-moonshot-api-key

# 飞书配置（用于飞书多维表格集成，也可在设置→扩展→飞书集成面板配置）
FEISHU_APP_ID=cli_a9xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your-feishu-app-secret

# 文件上传配置
# 留空则使用绝对路径（backend/uploads）。
# UPLOAD_DIR=
MAX_FILE_SIZE=10485760

# 向量数据库配置
# 留空则使用绝对路径（backend/chroma_db）。
# CHROMA_PERSIST_DIR=
