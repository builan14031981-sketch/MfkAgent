                      <span style={{ fontSize: "11px", fontFamily: "monospace", color: "var(--text-level-4)" }}>
                        {cm.model_id}
                      </span>
                      {cm.supports_vision && (
                        <span style={{
                          fontSize: "10px", padding: "1px 6px", borderRadius: "999px",
                          background: "rgba(139,92,246,0.12)", color: "var(--color-primary, #8b5cf6)", lineHeight: 1.4,
                        }}>Vision</span>
                      )}
                    </div>
                    <div style={{ fontSize: "11px", color: "var(--text-level-3)", marginTop: "2px" }}>
                      {cm.provider} · {cm.model_name} · {cm.api_base}
                    </div>
                  </div>
                  <span style={{ fontSize: "11px", color: cm.has_key ? "var(--color-success)" : "var(--text-level-4)" }}>
                    {cm.has_key ? "Key ✓" : "no key"}
                  </span>
                  <button onClick={() => handleToggleCustom(cm)} style={iconBtn} title={t("settings.model.custom.enabled")}>
                    {cm.enabled ? "ON" : "OFF"}
                  </button>
                  <button onClick={() => handleExpandEdit(cm)} style={{ ...iconBtn, background: isExpanded ? "rgba(99,102,241,0.1)" : "transparent" }} title="展开编辑">
                    {isExpanded ? <ChevronRight style={{ width: "14px", height: "14px", transform: "rotate(90deg)" }} /> : <Pencil style={{ width: "14px", height: "14px" }} />}
                  </button>
                  <button onClick={() => handleDeleteCustom(cm)} style={iconBtn} title={t("settings.model.custom.delete")}>
                    <Trash2 style={{ width: "14px", height: "14px", color: "var(--color-danger, #ef4444)" }} />
                  </button>
                </div>

                {/* 内联展开编辑区域 */}
                {isExpanded && (
                  <div style={{ padding: "14px", borderTop: "1px solid var(--border-primary)", background: "var(--bg-level-1)", display: "flex", flexDirection: "column", gap: "12px" }}>
                    {/* API Key + Base URL + 拉取按钮 */}
                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr auto", gap: "10px", alignItems: "flex-end" }}>
                      <div style={{ display: "flex", flexDirection: "column", gap: "4px" }}>
                        <label style={{ fontSize: "12px", color: "var(--text-level-2)" }}>API Key</label>
                        <ApiKeyInput value={editForm.api_key} onChange={(v) => setEditForm({ ...editForm, api_key: v })} placeholder="sk-..." showIcon={false} />
                      </div>
                      <div style={{ display: "flex", flexDirection: "column", gap: "4px" }}>
                        <label style={{ fontSize: "12px", color: "var(--text-level-2)" }}>端点地址 (Base URL)</label>
                        <input value={editForm.api_base} onChange={(e) => setEditForm({ ...editForm, api_base: e.target.value })} placeholder="http://127.0.0.1:8317/v1" style={inputStyle} />
                      </div>
                      <button onClick={handleEditFetchRemote} disabled={editRemoteLoading} style={{ display: "flex", alignItems: "center", gap: "6px", padding: "8px 14px", borderRadius: "var(--radius-sm)", border: "none", background: "var(--color-primary)", color: "#fff", cursor: editRemoteLoading ? "not-allowed" : "pointer", fontSize: "12px", fontWeight: "500", opacity: editRemoteLoading ? 0.6 : 1, whiteSpace: "nowrap" }}>
                        {editRemoteLoading ? <Loader2 style={{ width: "14px", height: "14px", animation: "spin 1s linear infinite" }} /> : <Globe style={{ width: "14px", height: "14px" }} />}
                        拉取模型列表
                      </button>
                    </div>

                    {/* 拉取的模型列表 */}
                    {editRemoteOpen && (
                      <div style={{ border: "1px solid var(--border-primary)", borderRadius: "var(--radius-sm)", maxHeight: "200px", overflowY: "auto" }}>
                        {editRemoteLoading && <div style={{ padding: "16px", textAlign: "center", color: "var(--text-level-3)", fontSize: "13px" }}><Loader2 style={{ width: "16px", height: "16px", animation: "spin 1s linear infinite", display: "inline-block", marginRight: "8px" }} />正在拉取...</div>}
                        {editRemoteError && <div style={{ padding: "12px", color: "var(--color-error)", fontSize: "13px" }}>{editRemoteError}</div>}
                        {!editRemoteLoading && !editRemoteError && editRemoteModels.map((m) => {
                          const alreadyAdded = existingModelNames.has(m.id);
                          return (
                            <div key={m.id} style={{ display: "flex", alignItems: "center", justifyContent: "space-between", padding: "8px 12px", borderBottom: "1px solid var(--border-primary)" }}>
                              <div style={{ display: "flex", alignItems: "center", gap: "8px" }}>
                                <span style={{ fontSize: "13px", color: "var(--text-level-1)" }}>{m.id}</span>
                                {m.context_window && <span style={{ fontSize: "11px", color: "var(--text-level-4)" }}>{(m.context_window / 1000).toFixed(0)}K</span>}
                              </div>
                              {alreadyAdded ? (
                                <span style={{ fontSize: "11px", color: "var(--text-level-4)" }}>已添加</span>
                              ) : (
                                <button onClick={() => handleEditAddModel(m.id, m.context_window || undefined)} style={{ padding: "4px 10px", borderRadius: "var(--radius-sm)", border: "1px solid var(--color-primary)", background: "transparent", color: "var(--color-primary)", cursor: "pointer", fontSize: "11px" }}>添加</button>
                              )}
                            </div>
                          );
                        })}
                      </div>
                    )}

                    {/* 当前模型高级参数 */}
                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: "10px" }}>
                      <div style={{ display: "flex", flexDirection: "column", gap: "4px" }}>
                        <label style={{ fontSize: "12px", color: "var(--text-level-2)" }}>最大 Token</label>
                        <input value={editForm.max_tokens} onChange={(e) => setEditForm({ ...editForm, max_tokens: e.target.value })} style={inputStyle} />
                      </div>
                      <div style={{ display: "flex", flexDirection: "column", gap: "4px" }}>
                        <label style={{ fontSize: "12px", color: "var(--text-level-2)" }}>温度</label>
                        <input value={editForm.temperature} onChange={(e) => setEditForm({ ...editForm, temperature: e.target.value })} style={inputStyle} />
                      </div>
                      <div style={{ display: "flex", flexDirection: "column", gap: "4px" }}>
                        <label style={{ fontSize: "12px", color: "var(--text-level-2)" }}>上下文窗口</label>
                        <input value={editForm.context_window} onChange={(e) => setEditForm({ ...editForm, context_window: e.target.value })} style={inputStyle} />
                      </div>
                    </div>
                    <div style={{ display: "flex", alignItems: "center", gap: "8px" }}>
                      <SwitchButton checked={editForm.supports_vision} onChange={() => setEditForm({ ...editForm, supports_vision: !editForm.supports_vision })} />
                      <span style={{ fontSize: "12px", color: "var(--text-level-2)" }}>支持多模态识图 (Vision)</span>
                    </div>

                    {/* 操作按钮 */}
                    <div style={{ display: "flex", justifyContent: "flex-end", gap: "8px" }}>
                      <button onClick={() => setExpandedId(null)} disabled={editSaving} style={secondaryBtn}>取消</button>
                      <button onClick={handleEditSave} disabled={editSaving} style={{ ...primaryBtn, opacity: editSaving ? 0.6 : 1, cursor: editSaving ? "not-allowed" : "pointer" }}>
                        {editSaving ? "保存中..." : "保存"}
                      </button>
                    </div>
                  </div>
                )}
              </div>
              );
            })}
          </div>
        )}
        </>
        )}
      </div>

      {/* 纹身图模型（生图专用 BYOK） */}
      <TattooImageConfigSection />

      {/* 备用识图模型（双轨 BYOK） */}
      <VisionConfigSection />

      {/* Provider Base URL 覆盖（深水区端点配置） */}
      <ProviderBaseUrlOverride />
    </div>
  );
}